<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getApiKey" xml:lang="en-US">
   <title>Get a specific API key by ID</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>api-keys</keyword>
         </keywords>
         <othermeta name="http-method" content="GET"/>
         <othermeta name="path" content="/api/v1/api-keys/{id}"/>
         <othermeta name="operationId" content="getApiKey"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>GET /api/v1/api-keys/{id}</b></p>
         <codeblock outputclass="language-http">GET /maas/api/v1/api-keys/{id}</codeblock>
      </refsyn>
      <section id="description">
         <p>Returns metadata for a single API key by its ID.</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="parameters">
         <title>Parameters</title>
         <simpletable relcolwidth="2* 1* 2* 1* 5*">
            <sthead>
               <stentry>Name</stentry>
               <stentry>In</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>id</codeph></stentry>
               <stentry>path</stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>ID of the API key to retrieve</p></stentry>
            </strow>
         </simpletable>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>OK response.</p></stentry>
               <stentry><p><xref href="../schemas/ApiKey.dita" type="reference">ApiKey</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>401</codeph> Unauthorized</stentry>
               <stentry><p>Unauthorized response.</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>404</codeph> Not Found</stentry>
               <stentry><p>Not Found. API key not found.</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry>None</stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X GET "/maas/api/v1/api-keys/{id}" \
  -H "Authorization: Bearer $TOKEN"</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>200</codeph> OK, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "id": "string",
  "name": "string",
  "description": "string",
  "username": "string",
  "groups": ["string"],
  "creationDate": "2024-01-31T09:30:00Z",
  "expirationDate": "2024-01-31T09:30:00Z",
  "status": "active",
  "lastUsedAt": "2024-01-31T09:30:00Z",
  "subscription": "premium-team-sub"
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/ApiKey.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
