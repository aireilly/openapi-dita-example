        "governanceAttached": true
      }
    }
  ]
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/ExternalModelSummary.dita" type="reference"/>
      </linklist>
