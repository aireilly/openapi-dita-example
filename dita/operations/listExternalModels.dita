          "config": {
            "key": "string"
          },
          "authMechanism": "apikey",
          "credentialSecretRef": "string",
          "provider": {
            "displayName": "string",
            "description": "string",
            "endpointUrl": "string",
            "authMechanism": "apikey",
            "credentialSecretRef": "string",
            "provider": "string",
            "config": {},
            "phase": "string",
            "statusMessage": "string",
            "reason": "Reconciled"
          }
        }
      ],
      "phase": "string",
