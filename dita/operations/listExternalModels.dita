<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="listExternalModels" xml:lang="en-US">
   <title>List ExternalModels</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>externalmodels</keyword>
         </keywords>
         <othermeta name="http-method" content="GET"/>
         <othermeta name="path" content="/api/v1/externalmodel"/>
         <othermeta name="operationId" content="listExternalModels"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>GET /api/v1/externalmodel</b></p>
         <codeblock outputclass="language-http">GET /maas/api/v1/externalmodel</codeblock>
      </refsyn>
      <section id="description">
         <p>Returns ExternalModels enriched with referenced ExternalProvider details and companion MaaSModelRef endpoint status.</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="parameters">
         <title>Parameters</title>
         <simpletable relcolwidth="2* 1* 2* 1* 5*">
            <sthead>
               <stentry>Name</stentry>
               <stentry>In</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>namespace</codeph></stentry>
               <stentry>query</stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
         </simpletable>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>ExternalModel list</p></stentry>
               <stentry><p>object</p><p><codeph>application/json</codeph></p></stentry>
            </strow>
         </simpletable>
         <p><b>200 OK response body</b></p>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>data</codeph></stentry>
               <stentry>array of <xref href="../schemas/ExternalModelSummary.dita" type="reference">ExternalModelSummary</xref></stentry>
               <stentry>No</stentry>
               <stentry/>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X GET "/maas/api/v1/externalmodel?namespace=NAMESPACE" \
  -H "Authorization: Bearer $TOKEN"</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>200</codeph> OK, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "data": [
    {
      "name": "string",
      "namespace": "string",
      "displayName": "string",
      "description": "string",
      "modelName": "string",
      "providerRefs": [
        {
          "providerName": "string",
          "weight": 0,
          "apiFormat": "string",
          "path": "string",
