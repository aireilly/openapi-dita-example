<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getSubscriptionInfo" xml:lang="en-US">
   <title>Get subscription details</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>subscriptions</keyword>
         </keywords>
         <othermeta name="http-method" content="GET"/>
         <othermeta name="path" content="/api/v1/subscription-info/{name}"/>
         <othermeta name="operationId" content="getSubscriptionInfo"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>GET /api/v1/subscription-info/{name}</b></p>
         <codeblock outputclass="language-http">GET /maas/api/v1/subscription-info/{name}</codeblock>
      </refsyn>
      <section id="description">
         <p>Returns detailed information about a specific subscription, including the MaaSSubscription resource, related MaaSModelRef resources, and associated MaaSAuthPolicy resources.
K8s calls: GET /k8s/v1/maassubscription/:name, GET /k8s/v1/maasmodelref, GET /k8s/v1/maasauthpolicy</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="parameters">
         <title>Parameters</title>
         <simpletable relcolwidth="2* 1* 2* 1* 5*">
            <sthead>
               <stentry>Name</stentry>
               <stentry>In</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>name</codeph></stentry>
               <stentry>path</stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Name of the MaaSSubscription resource</p></stentry>
            </strow>
         </simpletable>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>Subscription details with related resources</p></stentry>
               <stentry><p><xref href="../schemas/SubscriptionInfoResponse.dita" type="reference">SubscriptionInfoResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>401</codeph> Unauthorized</stentry>
               <stentry><p>Unauthorized</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>403</codeph> Forbidden</stentry>
               <stentry><p>Forbidden</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>404</codeph> Not Found</stentry>
               <stentry><p>Subscription not found</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X GET "/maas/api/v1/subscription-info/{name}" \
  -H "Authorization: Bearer $TOKEN"</codeblock>
      </example>
