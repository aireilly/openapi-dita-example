<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getApiKeyConfig" xml:lang="en-US">
   <title>Get API key configuration limits</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>api-keys</keyword>
         </keywords>
         <othermeta name="http-method" content="GET"/>
         <othermeta name="path" content="/api/v1/api-keys-config"/>
         <othermeta name="operationId" content="getApiKeyConfig"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>GET /api/v1/api-keys-config</b></p>
         <codeblock outputclass="language-http">GET /maas/api/v1/api-keys-config</codeblock>
      </refsyn>
      <section id="description">
         <p>Returns the API key limits that apply when creating keys. Useful for clients that need to display valid ranges for expiration without requiring admin access to the Tenant CR. Proxies maas-api GET /v1/api-keys/config. Registered as /api-keys-config (not /api-keys/config) to avoid conflicting with httprouter GET /api-keys/:id.</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>OK response.</p></stentry>
               <stentry><p>object</p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>401</codeph> Unauthorized</stentry>
               <stentry><p>Unauthorized response.</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry>None</stentry>
            </strow>
         </simpletable>
         <p><b>200 OK response body</b></p>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>data</codeph></stentry>
               <stentry><xref href="../schemas/ApiKeyConfig.dita" type="reference">ApiKeyConfig</xref></stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X GET "/maas/api/v1/api-keys-config" \
  -H "Authorization: Bearer $TOKEN"</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>200</codeph> OK, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "data": {
    "max_expiration_days": 90,
    "ephemeral_max_expiration": "1h"
  }
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/ApiKeyConfig.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
