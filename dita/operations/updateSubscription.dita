<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="updateSubscription" xml:lang="en-US">
   <title>Update an existing subscription</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>subscriptions</keyword>
         </keywords>
         <othermeta name="http-method" content="PUT"/>
         <othermeta name="path" content="/api/v1/update-subscription/{name}"/>
         <othermeta name="operationId" content="updateSubscription"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>PUT /api/v1/update-subscription/{name}</b></p>
         <codeblock outputclass="language-http">PUT /maas/api/v1/update-subscription/{name}</codeblock>
      </refsyn>
      <section id="description">
         <p>Updates an existing MaaSSubscription and its associated MaaSAuthPolicy.
K8s calls: PUT /k8s/v1/maassubscription/:name, PUT /k8s/v1/maasauthpolicy/:name</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="parameters">
         <title>Parameters</title>
         <simpletable relcolwidth="2* 1* 2* 1* 5*">
            <sthead>
               <stentry>Name</stentry>
               <stentry>In</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>name</codeph></stentry>
               <stentry>path</stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Name of the MaaSSubscription to update</p></stentry>
            </strow>
         </simpletable>
      </section>
      <section id="request-body">
         <title>Request body</title>
         <p>Required.</p>
         <p>Content type: <codeph>application/json</codeph></p>
         <p>Schema: <xref href="../schemas/UpdateSubscriptionRequest.dita" type="reference">UpdateSubscriptionRequest</xref></p>
         <p>Example:</p>
         <codeblock outputclass="language-json">{
  "owner": {
    "groups": [
      {
        "name": "premium-users"
      },
      {
        "name": "beta-testers"
      }
    ]
  },
  "modelRefs": [
    {
      "name": "llama-2-7b-chat",
      "namespace": "maas-models",
      "tokenRateLimits": [
        {
          "limit": 200000,
          "window": "24h"
        }
      ]
    },
    {
      "name": "mistral-7b-instruct",
      "namespace": "maas-models",
      "tokenRateLimits": [
        {
          "limit": 300000,
          "window": "24h"
        }
      ]
    }
  ],
  "tokenMetadata": {
    "organizationId": "org-123",
    "costCenter": "engineering-v2"
  },
  "inferencePriority": 20
}</codeblock>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>Subscription and auth policy updated successfully</p></stentry>
               <stentry><p><xref href="../schemas/CreateSubscriptionResponse.dita" type="reference">CreateSubscriptionResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>400</codeph> Bad Request</stentry>
               <stentry><p>Bad Request. Invalid update specification.</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>401</codeph> Unauthorized</stentry>
               <stentry><p>Unauthorized</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>403</codeph> Forbidden</stentry>
               <stentry><p>Forbidden</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>404</codeph> Not Found</stentry>
               <stentry><p>Subscription not found</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X PUT "/maas/api/v1/update-subscription/{name}" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
  "owner": {
    "groups": [
      {
        "name": "premium-users"
      },
      {
        "name": "beta-testers"
      }
    ]
  },
  "modelRefs": [
    {
      "name": "llama-2-7b-chat",
      "namespace": "maas-models",
      "tokenRateLimits": [
        {
          "limit": 200000,
          "window": "24h"
        }
      ]
    },
    {
      "name": "mistral-7b-instruct",
      "namespace": "maas-models",
      "tokenRateLimits": [
        {
          "limit": 300000,
          "window": "24h"
        }
      ]
    }
  ],
  "tokenMetadata": {
    "organizationId": "org-123",
    "costCenter": "engineering-v2"
  },
  "inferencePriority": 20
}'</codeblock>
      </example>
