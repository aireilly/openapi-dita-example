<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="createSecret" xml:lang="en-US">
   <title>Create a Secret</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>secrets</keyword>
         </keywords>
         <othermeta name="http-method" content="POST"/>
         <othermeta name="path" content="/api/v1/secrets"/>
         <othermeta name="operationId" content="createSecret"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>POST /api/v1/secrets</b></p>
         <codeblock outputclass="language-http">POST /maas/api/v1/secrets</codeblock>
      </refsyn>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="request-body">
         <title>Request body</title>
         <p>Required.</p>
         <p>Content type: <codeph>application/json</codeph></p>
         <p>Schema: <xref href="../schemas/CreateSecretRequest.dita" type="reference">CreateSecretRequest</xref></p>
         <p>Example:</p>
         <codeblock outputclass="language-json">{
  "namespace": "string",
  "name": "string",
  "value": "string"
}</codeblock>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>201</codeph> Created</stentry>
               <stentry><p>Secret created</p></stentry>
               <stentry>None</stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X POST "/maas/api/v1/secrets" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
  "namespace": "string",
  "name": "string",
  "value": "string"
}'</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/CreateSecretRequest.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
