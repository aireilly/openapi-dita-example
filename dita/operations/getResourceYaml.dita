<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getResourceYaml" xml:lang="en-US">
   <title>Get resource YAML</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>yaml</keyword>
         </keywords>
         <othermeta name="http-method" content="GET"/>
         <othermeta name="path" content="/api/v1/yaml"/>
         <othermeta name="operationId" content="getResourceYaml"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>GET /api/v1/yaml</b></p>
         <codeblock outputclass="language-http">GET /maas/api/v1/yaml</codeblock>
      </refsyn>
      <section id="description">
         <p>Fetches a MaaSSubscription or MaaSAuthPolicy by name and returns its YAML representation.
K8s calls: GET /k8s/v1/maassubscription/:name or GET /k8s/v1/maasauthpolicy/:name</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="parameters">
         <title>Parameters</title>
         <simpletable relcolwidth="2* 1* 2* 1* 5*">
            <sthead>
               <stentry>Name</stentry>
               <stentry>In</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>name</codeph></stentry>
               <stentry>query</stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Kubernetes resource name</p><p>Example: <codeph>premium-team-sub</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>type</codeph></stentry>
               <stentry>query</stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Resource type to fetch</p><p>Allowed values: <codeph>subscription</codeph>, <codeph>authorizationpolicy</codeph></p><p>Example: <codeph>subscription</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>YAML content for the requested resource</p></stentry>
               <stentry><p><xref href="../schemas/YamlResponse.dita" type="reference">YamlResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>400</codeph> Bad Request</stentry>
               <stentry><p>Bad Request (missing or invalid query parameters)</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>404</codeph> Not Found</stentry>
               <stentry><p>Resource not found</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X GET "/maas/api/v1/yaml?name=premium-team-sub&amp;type=subscription" \
  -H "Authorization: Bearer $TOKEN"</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>200</codeph> OK, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "content": "apiVersion: maas.opendatahub.io/v1alpha1\nkind: MaaSSubscription\nmetadata:\n  name: premium-team-sub\n  namespace: maas-system\nspec:\n  inferencePriority: 10\n  owner:\n    groups:\n      - name: premium-users\n"
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/YamlResponse.dita" type="reference"/>
         <link href="../schemas/ErrorResponse.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
