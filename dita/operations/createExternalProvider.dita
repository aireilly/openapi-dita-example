<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="createExternalProvider" xml:lang="en-US">
   <title>Create an ExternalProvider</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>externalproviders</keyword>
         </keywords>
         <othermeta name="http-method" content="POST"/>
         <othermeta name="path" content="/api/v1/externalprovider"/>
         <othermeta name="operationId" content="createExternalProvider"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>POST /api/v1/externalprovider</b></p>
         <codeblock outputclass="language-http">POST /maas/api/v1/externalprovider</codeblock>
      </refsyn>
      <section id="description">
         <p>Creates a new ExternalProvider.</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="request-body">
         <title>Request body</title>
         <p>Required.</p>
         <p>Content type: <codeph>application/json</codeph></p>
         <p>Schema: <xref href="../schemas/CreateExternalProviderRequest.dita" type="reference">CreateExternalProviderRequest</xref></p>
         <p>Example:</p>
         <codeblock outputclass="language-json">{
  "name": "string",
  "namespace": "string",
  "displayName": "string",
  "description": "string",
  "endpointUrl": "string",
  "authMechanism": "apikey",
  "credentialSecretRef": "string",
  "provider": "string",
  "config": {
    "key": "string"
  }
}</codeblock>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>201</codeph> Created</stentry>
               <stentry><p>ExternalProvider created</p></stentry>
               <stentry>None</stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X POST "/maas/api/v1/externalprovider" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
  "name": "string",
  "namespace": "string",
  "displayName": "string",
  "description": "string",
  "endpointUrl": "string",
  "authMechanism": "apikey",
  "credentialSecretRef": "string",
  "provider": "string",
  "config": {
    "key": "string"
  }
}'</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/CreateExternalProviderRequest.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
