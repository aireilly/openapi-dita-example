<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="createSubscription" xml:lang="en-US">
   <title>Create a new subscription</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>subscriptions</keyword>
         </keywords>
         <othermeta name="http-method" content="POST"/>
         <othermeta name="path" content="/api/v1/new-subscription"/>
         <othermeta name="operationId" content="createSubscription"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>POST /api/v1/new-subscription</b></p>
         <codeblock outputclass="language-http">POST /maas/api/v1/new-subscription</codeblock>
      </refsyn>
      <section id="description">
         <p>Creates a new MaaSSubscription and its associated MaaSAuthPolicy.
K8s calls: CREATE /k8s/v1/maassubscription, CREATE /k8s/v1/maasauthpolicy</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="request-body">
         <title>Request body</title>
         <p>Required.</p>
         <p>Content type: <codeph>application/json</codeph></p>
         <p>Schema: <xref href="../schemas/CreateSubscriptionRequest.dita" type="reference">CreateSubscriptionRequest</xref></p>
         <p>Example:</p>
         <codeblock outputclass="language-json">{
  "name": "team-alpha-sub",
  "namespace": "maas-system",
  "owner": {
    "groups": [
      {
        "name": "team-alpha"
      }
    ]
  },
  "modelRefs": [
    {
      "name": "llama-2-7b-chat",
      "namespace": "maas-models",
      "tokenRateLimits": [
        {
          "limit": 50000,
          "window": "24h"
        }
      ]
    }
  ],
  "inferencePriority": 0
}</codeblock>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>201</codeph> Created</stentry>
               <stentry><p>Subscription and auth policy created successfully</p></stentry>
               <stentry><p><xref href="../schemas/CreateSubscriptionResponse.dita" type="reference">CreateSubscriptionResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>400</codeph> Bad Request</stentry>
               <stentry><p>Bad Request. Invalid subscription specification.</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>401</codeph> Unauthorized</stentry>
               <stentry><p>Unauthorized</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>403</codeph> Forbidden</stentry>
               <stentry><p>Forbidden</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>409</codeph> Conflict</stentry>
               <stentry><p>Conflict. Subscription with this name already exists.</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X POST "/maas/api/v1/new-subscription" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
  "name": "team-alpha-sub",
  "namespace": "maas-system",
  "owner": {
    "groups": [
      {
        "name": "team-alpha"
      }
    ]
  },
  "modelRefs": [
    {
      "name": "llama-2-7b-chat",
      "namespace": "maas-models",
      "tokenRateLimits": [
        {
          "limit": 50000,
          "window": "24h"
        }
      ]
    }
  ],
  "inferencePriority": 0
}'</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>201</codeph> Created, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "subscription": {
    "name": "premium-team-sub",
    "namespace": "maas-system",
    "phase": "Pending",
    "inferencePriority": 10,
    "owner": {
      "groups": [
        {
          "name": "premium-users"
        }
      ]
    },
    "modelRefs": [
      {
        "name": "llama-2-7b-chat",
        "namespace": "maas-models",
        "tokenRateLimits": [
          {
            "limit": 100000,
            "window": "24h"
          }
        ]
      }
    ],
    "creationTimestamp": "2025-03-16T10:00:00Z"
  },
  "authPolicy": {
    "name": "premium-team-sub-policy",
    "namespace": "maas-system",
    "phase": "Pending",
    "modelRefs": [
      {
        "name": "llama-2-7b-chat",
        "namespace": "maas-models"
      }
    ],
    "subjects": {
      "groups": [
        {
          "name": "premium-users"
        }
      ]
    }
  }
}</codeblock>
      </example>
   </refbody>
