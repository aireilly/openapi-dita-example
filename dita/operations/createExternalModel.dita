<reference id="createExternalModel" xml:lang="en-US">
   <title>Create an ExternalModel</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>externalmodels</keyword>
         </keywords>
         <othermeta name="http-method" content="POST"/>
         <othermeta name="path" content="/api/v1/externalmodel"/>
         <othermeta name="operationId" content="createExternalModel"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>POST /api/v1/externalmodel</b></p>
         <codeblock outputclass="language-http">POST /maas/api/v1/externalmodel</codeblock>
      </refsyn>
      <section id="description">
         <p>Creates a new ExternalModel and its companion MaaSModelRef.</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="request-body">
         <title>Request body</title>
         <p>Required.</p>
         <p>Content type: <codeph>application/json</codeph></p>
         <p>Schema: <xref href="../schemas/CreateExternalModelRequest.dita" type="reference">CreateExternalModelRequest</xref></p>
         <p>Example:</p>
         <codeblock outputclass="language-json">{
  "name": "string",
  "namespace": "string",
  "displayName": "string",
  "description": "string",
  "modelName": "string",
  "providerRefs": [
    {
      "providerName": "string",
      "weight": 0,
      "apiFormat": "string",
      "path": "string",
      "targetModel": "string",
      "config": {
        "key": "string"
      },
      "authMechanism": "apikey",
      "credentialSecretRef": "string",
      "provider": {
