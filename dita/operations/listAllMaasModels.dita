<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="listAllMaasModels" xml:lang="en-US">
   <title>List all MaaS model refs</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>models</keyword>
         </keywords>
         <othermeta name="http-method" content="GET"/>
         <othermeta name="path" content="/api/v1/all-maas-models"/>
         <othermeta name="operationId" content="listAllMaasModels"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>GET /api/v1/all-maas-models</b></p>
         <codeblock outputclass="language-http">GET /maas/api/v1/all-maas-models</codeblock>
      </refsyn>
      <section id="description">
         <p>Returns all MaaSModelRef resources across the cluster as summaries.
K8s calls: GET /k8s/v1/maasmodelref</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>List of MaaSModelRef summaries</p></stentry>
               <stentry><p>object</p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>401</codeph> Unauthorized</stentry>
               <stentry><p>Unauthorized</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
         </simpletable>
         <p><b>200 OK response body</b></p>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>data</codeph></stentry>
               <stentry>array of <xref href="../schemas/MaaSModelRefSummary.dita" type="reference">MaaSModelRefSummary</xref></stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X GET "/maas/api/v1/all-maas-models" \
  -H "Authorization: Bearer $TOKEN"</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>200</codeph> OK, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "data": [
    {
      "name": "granite-3-8b-instruct",
      "namespace": "maas-models",
      "displayName": "Granite 3 8B Instruct",
      "description": "IBM Granite 3 8B instruction-tuned language model.",
      "phase": "Ready",
      "modelRef": {
        "kind": "InferenceService",
        "name": "granite-3-8b-instruct"
      }
    }
  ]
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/MaaSModelRefSummary.dita" type="reference"/>
         <link href="../schemas/ErrorResponse.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
