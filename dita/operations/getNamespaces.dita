<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getNamespaces" xml:lang="en-US">
   <title>Get Namespaces</title>
   <prolog>
      <metadata>
         <othermeta name="http-method" content="GET"/>
         <othermeta name="path" content="/api/v1/namespaces"/>
         <othermeta name="operationId" content="getNamespaces"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>GET /api/v1/namespaces</b></p>
         <codeblock outputclass="language-http">GET /maas/api/v1/namespaces</codeblock>
      </refsyn>
      <section id="description">
         <p>Returns namespaces accessible to the user. Cluster admins receive all non-system
namespaces. Regular users receive only OpenShift projects they can access. System
namespaces (for example <codeph>openshift-*</codeph>, <codeph>kube-*</codeph>, <codeph>default</codeph>, <codeph>opendatahub</codeph>) are excluded.</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>List of namespaces</p></stentry>
               <stentry><p>object</p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>400</codeph> Bad Request</stentry>
               <stentry><p>Bad Request</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>401</codeph> Unauthorized</stentry>
               <stentry><p>Unauthorized</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry>None</stentry>
            </strow>
         </simpletable>
         <p><b>200 OK response body</b></p>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>data</codeph></stentry>
               <stentry>array of <xref href="../schemas/Namespace.dita" type="reference">Namespace</xref></stentry>
               <stentry>No</stentry>
               <stentry/>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X GET "/maas/api/v1/namespaces" \
  -H "Authorization: Bearer $TOKEN"</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>200</codeph> OK, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "data": [
    {
      "name": "string",
      "displayName": "string"
    }
  ]
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/Namespace.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
