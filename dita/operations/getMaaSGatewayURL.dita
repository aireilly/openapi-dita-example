<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="getMaaSGatewayURL" xml:lang="en-US">
   <title>Get MaaS gateway URL</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>gateway</keyword>
         </keywords>
         <othermeta name="http-method" content="GET"/>
         <othermeta name="path" content="/api/v1/gateway-url"/>
         <othermeta name="operationId" content="getMaaSGatewayURL"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>GET /api/v1/gateway-url</b></p>
         <codeblock outputclass="language-http">GET /maas/api/v1/gateway-url</codeblock>
      </refsyn>
      <section id="description">
         <p>Returns the externally reachable MaaS API base URL discovered from the maas-default-gateway tenant. The URL includes the /maas-api path.</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>200</codeph> OK</stentry>
               <stentry><p>MaaS gateway URL</p></stentry>
               <stentry><p>object</p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>503</codeph> Service Unavailable</stentry>
               <stentry><p>MaaS gateway discovery is not complete</p></stentry>
               <stentry><p><xref href="../schemas/ErrorResponse.dita" type="reference">ErrorResponse</xref></p><p><codeph>application/json</codeph></p></stentry>
            </strow>
         </simpletable>
         <p><b>200 OK response body</b></p>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>data</codeph></stentry>
               <stentry><xref href="../schemas/MaaSGatewayURL.dita" type="reference">MaaSGatewayURL</xref></stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X GET "/maas/api/v1/gateway-url" \
  -H "Authorization: Bearer $TOKEN"</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>200</codeph> OK, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "data": {
    "url": "https://maas.apps.example.com/maas-api"
  }
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Data models</title>
         <link href="../schemas/MaaSGatewayURL.dita" type="reference"/>
         <link href="../schemas/ErrorResponse.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
