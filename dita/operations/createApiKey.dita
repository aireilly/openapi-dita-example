<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="createApiKey" xml:lang="en-US">
   <title>Create a new hash-based API key</title>
   <prolog>
      <metadata>
         <keywords>
            <keyword>api-keys</keyword>
         </keywords>
         <othermeta name="http-method" content="POST"/>
         <othermeta name="path" content="/api/v1/api-keys"/>
         <othermeta name="operationId" content="createApiKey"/>
      </metadata>
   </prolog>
   <refbody>
      <refsyn>
         <p outputclass="api-endpoint"><b>POST /api/v1/api-keys</b></p>
         <codeblock outputclass="language-http">POST /maas/api/v1/api-keys</codeblock>
      </refsyn>
      <section id="description">
         <p>Creates a new OpenAI-compatible API key (sk-oai-* format). Supports both permanent keys (no expiration) and expiring keys (with expiresIn parameter). The plaintext key is shown ONLY ONCE at creation time and cannot be retrieved again.</p>
      </section>
      <section id="authorization">
         <title>Authorization</title>
         <ul>
            <li><xref href="../overview.dita#overview/authentication" type="section">bearerAuth</xref></li>
         </ul>
      </section>
      <section id="request-body">
         <title>Request body</title>
         <p>Required.</p>
         <p>Content type: <codeph>application/json</codeph></p>
         <p>Schema: object</p>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>data</codeph></stentry>
               <stentry>object</stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
            <strow>
               <stentry><codeph>data.name</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Human-readable name for the API key</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.description</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Optional description</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.expiresIn</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Optional expiration duration (e.g., "30d", "90d", "1h"). Omit for permanent key.</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.subscription</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Subscription ID header to scope this API key to a specific subscription.</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.ephemeral</codeph></stentry>
               <stentry>boolean</stentry>
               <stentry>No</stentry>
               <stentry><p>When true, requests an ephemeral key (short-lived); forwarded to maas-api.</p></stentry>
            </strow>
         </simpletable>
         <p>Example:</p>
         <codeblock outputclass="language-json">{
  "data": {
    "name": "my-permanent-key",
    "description": "Production API key",
    "subscription": "premium-team-sub"
  }
}</codeblock>
      </section>
      <section id="responses">
         <title>Responses</title>
         <simpletable relcolwidth="1* 4* 3*">
            <sthead>
               <stentry>Status</stentry>
               <stentry>Description</stentry>
               <stentry>Response body</stentry>
            </sthead>
            <strow>
               <stentry><codeph>201</codeph> Created</stentry>
               <stentry><p>Created response.</p></stentry>
               <stentry><p>object</p><p><codeph>application/json</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>400</codeph> Bad Request</stentry>
               <stentry><p>Bad Request response.</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>401</codeph> Unauthorized</stentry>
               <stentry><p>Unauthorized response.</p></stentry>
               <stentry>None</stentry>
            </strow>
            <strow>
               <stentry><codeph>500</codeph> Internal Server Error</stentry>
               <stentry><p>Internal Server Error</p></stentry>
               <stentry>None</stentry>
            </strow>
         </simpletable>
         <p><b>201 Created response body</b></p>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>data</codeph></stentry>
               <stentry>object</stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
            <strow>
               <stentry><codeph>data.key</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Plaintext API key (SHOWN ONCE, NEVER AGAIN)</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.keyPrefix</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Display prefix for UI (e.g., sk-oai-abc)</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.id</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Unique identifier for the key</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.name</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Name of the key</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.createdAt</codeph></stentry>
               <stentry>string (date-time)</stentry>
               <stentry>No</stentry>
               <stentry><p>Creation timestamp (RFC3339)</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data.expiresAt</codeph></stentry>
               <stentry>string (date-time)</stentry>
               <stentry>No</stentry>
               <stentry><p>Expiration timestamp (RFC3339), omitted for permanent keys</p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example-request">
         <title>Example request</title>
         <codeblock outputclass="language-bash">curl -X POST "/maas/api/v1/api-keys" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d '{
  "data": {
    "name": "my-permanent-key",
    "description": "Production API key",
    "subscription": "premium-team-sub"
  }
}'</codeblock>
      </example>
      <example id="example-response">
         <title>Example response</title>
         <p><codeph>201</codeph> Created, <codeph>application/json</codeph></p>
         <codeblock outputclass="language-json">{
  "data": {
    "key": "string",
    "keyPrefix": "string",
    "id": "string",
    "name": "string",
    "createdAt": "2024-01-31T09:30:00Z",
    "expiresAt": "2024-01-31T09:30:00Z"
  }
}</codeblock>
      </example>
   </refbody>
</reference>
