<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="ModelSubscriptionRef" xml:lang="en-US">
   <title>ModelSubscriptionRef</title>
   <refbody>
      <section id="description">
         <p>Reference to a model with rate limits within a subscription. Per-model inference status fields are read-only and populated from status.flowControlStatuses on the MaaSSubscription CR.</p>
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>name</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Name of the MaaSModelRef</p><p>Example: <codeph>llama-2-7b-chat</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>namespace</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Namespace where the MaaSModelRef lives</p><p>Example: <codeph>maas-models</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>tokenRateLimits</codeph></stentry>
               <stentry>array of <xref href="TokenRateLimit.dita" type="reference">TokenRateLimit</xref></stentry>
               <stentry>No</stentry>
               <stentry><p>Token-based rate limits for this model</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>billingRate</codeph></stentry>
               <stentry><xref href="BillingRate.dita" type="reference">BillingRate</xref></stentry>
               <stentry>No</stentry>
               <stentry/>
            </strow>
            <strow>
               <stentry><codeph>objectiveName</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Inference objective name from status.flowControlStatuses (read-only)</p><p>Example: <codeph>maas-models-as-a-service-gold-maas-model-user-inference-pool-a1b2c3d4e5</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>targetPool</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Inference pool name from status.flowControlStatuses.inferencePool.name (read-only)</p><p>Example: <codeph>maas-model-user-inference-pool</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>ready</codeph></stentry>
               <stentry>boolean</stentry>
               <stentry>No</stentry>
               <stentry><p>Per-model readiness from status.flowControlStatuses.ready (read-only)</p><p>Example: <codeph>true</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>reason</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Per-model status reason from status.flowControlStatuses (read-only)</p><p>Example: <codeph>ObjectiveReconciled</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>message</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Per-model status message from status.flowControlStatuses (read-only)</p><p>Example: <codeph>InferenceObjective sets priority 10</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "name": "llama-2-7b-chat",
  "namespace": "maas-models",
  "tokenRateLimits": [
    {
      "limit": 100000,
      "window": "24h"
    }
  ],
  "billingRate": {
    "perToken": "0.0001"
  },
  "objectiveName": "maas-models-as-a-service-gold-maas-model-user-inference-pool-a1b2c3d4e5",
  "targetPool": "maas-model-user-inference-pool",
  "ready": true,
  "reason": "ObjectiveReconciled",
  "message": "InferenceObjective sets priority 10"
}</codeblock>
      </example>
   </refbody>
