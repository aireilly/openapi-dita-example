<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="ApiKeyListResponse" xml:lang="en-US">
   <title>ApiKeyListResponse</title>
   <refbody>
      <section id="description">
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>object</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Object type, always "list"</p><p>Example: <codeph>list</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>data</codeph></stentry>
               <stentry>array of <xref href="ApiKey.dita" type="reference">ApiKey</xref></stentry>
               <stentry>Yes</stentry>
               <stentry><p>Array of API key metadata objects</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>has_more</codeph></stentry>
               <stentry>boolean</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Whether there are more results beyond this page</p><p>Example: <codeph>true</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>subscriptionDetails</codeph></stentry>
               <stentry>map of <xref href="SubscriptionDetail.dita" type="reference">SubscriptionDetail</xref></stentry>
               <stentry>No</stentry>
               <stentry><p>Map of subscription name to its details (display name and model names) for subscriptions referenced by the returned API keys. Used by the UI to derive Inactive status (active key whose subscription is missing) and to enrich the subscription column. For MaaS admins the BFF fills this from a Kubernetes list of MaaSSubscription CRs; for non-admins it uses the caller-scoped MaaS API /subscriptions list.</p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "object": "list",
  "data": [
    {
      "id": "string",
      "name": "string",
      "description": "string",
      "username": "string",
      "groups": ["string"],
      "creationDate": "2024-01-31T09:30:00Z",
      "expirationDate": "2024-01-31T09:30:00Z",
      "status": "active",
      "lastUsedAt": "2024-01-31T09:30:00Z",
      "subscription": "premium-team-sub"
    }
  ],
  "has_more": true,
  "subscriptionDetails": {
    "key": {
      "displayName": "Premium Team",
      "models": ["granite-3-8b-instruct", "flan-t5-small"]
    }
  }
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Used by</title>
         <link href="../operations/searchApiKeys.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
