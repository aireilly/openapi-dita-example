<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="ModelReference" xml:lang="en-US">
   <title>ModelReference</title>
   <refbody>
      <section id="description">
         <p>Reference to a model endpoint</p>
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>kind</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Kind of the model resource</p><p>Allowed values: <codeph>LLMInferenceService</codeph>, <codeph>ExternalModel</codeph></p><p>Example: <codeph>LLMInferenceService</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>name</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Name of the model resource</p><p>Example: <codeph>llama-2-7b-chat</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "kind": "LLMInferenceService",
  "name": "llama-2-7b-chat"
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Used by</title>
         <link href="MaaSModelRefSummary.dita" type="reference"/>
         <link href="CreateMaaSModelRefRequest.dita" type="reference"/>
         <link href="UpdateMaaSModelRefRequest.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
