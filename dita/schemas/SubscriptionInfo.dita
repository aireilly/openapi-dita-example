<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="SubscriptionInfo" xml:lang="en-US">
   <title>SubscriptionInfo</title>
   <refbody>
      <section id="description">
         <p>Subscription metadata (maas-api <codeph>SubscriptionInfo</codeph>).
When <codeph>X-MaaS-Return-All-Models</codeph> is used, models accessible via multiple subscriptions
include multiple entries in the model's <codeph>subscriptions</codeph> array.</p>
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>name</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>The subscription name</p><p>Example: <codeph>premium-subscription</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>displayName</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Human-readable display name for the subscription</p><p>Example: <codeph>Premium Subscription</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>description</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Description of the subscription</p><p>Example: <codeph>Premium subscription with higher rate limits</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "name": "premium-subscription",
  "displayName": "Premium Subscription",
  "description": "Premium subscription with higher rate limits"
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Used by</title>
         <link href="Model.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
