<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="TokenMetadata" xml:lang="en-US">
   <title>TokenMetadata</title>
   <refbody>
      <section id="description">
         <p>Metadata for token usage attribution and metering</p>
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>organizationId</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Organization identifier for metering and billing</p><p>Example: <codeph>org-123</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>costCenter</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Cost center for usage attribution</p><p>Example: <codeph>engineering</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>labels</codeph></stentry>
               <stentry>map of string</stentry>
               <stentry>No</stentry>
               <stentry><p>Additional labels for tracking and metrics</p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "organizationId": "org-123",
  "costCenter": "engineering",
  "labels": {
    "key": "string"
  }
}</codeblock>
      </example>
   </refbody>
