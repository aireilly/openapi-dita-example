      <linklist>
         <title>Used by</title>
         <link href="ExternalModelSummary.dita" type="reference"/>
         <link href="CreateExternalModelRequest.dita" type="reference"/>
         <link href="UpdateExternalModelRequest.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
