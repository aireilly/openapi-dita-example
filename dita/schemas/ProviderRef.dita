<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="ProviderRef" xml:lang="en-US">
   <title>ProviderRef</title>
   <refbody>
      <section id="description">
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>providerName</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
            <strow>
               <stentry><codeph>weight</codeph></stentry>
               <stentry>integer</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Relative traffic proportion. 0 disables the ref. Defaults to 1 if omitted on the CR.</p><p>Constraints: minimum 0; maximum 100</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>apiFormat</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
            <strow>
               <stentry><codeph>path</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
            <strow>
               <stentry><codeph>targetModel</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry/>
            </strow>
            <strow>
               <stentry><codeph>config</codeph></stentry>
               <stentry>map of string</stentry>
               <stentry>No</stentry>
               <stentry><p>Optional model-provider binding configuration (externalProviderRefs.config)</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>authMechanism</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Auth type override from the ExternalModel providerRef (overrides ExternalProvider auth)</p><p>Allowed values: <codeph>apikey</codeph>, <codeph>sigv4</codeph>, <codeph>oauth2</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>credentialSecretRef</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Secret name override from the ExternalModel providerRef (overrides ExternalProvider auth.secretRef)</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>provider</codeph></stentry>
               <stentry><xref href="ExternalProviderDetails.dita" type="reference">ExternalProviderDetails</xref></stentry>
               <stentry>No</stentry>
               <stentry><p>Enriched from the referenced ExternalProvider (list response only). Auth fields reflect model-level overrides when present.</p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "providerName": "string",
  "weight": 0,
  "apiFormat": "string",
  "path": "string",
  "targetModel": "string",
  "config": {
    "key": "string"
  },
  "authMechanism": "apikey",
  "credentialSecretRef": "string",
  "provider": {
    "displayName": "string",
    "description": "string",
    "endpointUrl": "string",
    "authMechanism": "apikey",
    "credentialSecretRef": "string",
    "provider": "string",
    "config": {
      "key": "string"
    },
    "phase": "string",
    "statusMessage": "string",
    "reason": "Reconciled"
  }
}</codeblock>
      </example>
   </refbody>
