<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="OwnerSpec" xml:lang="en-US">
   <title>OwnerSpec</title>
   <refbody>
      <section id="description">
         <p>Defines who owns a subscription</p>
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>groups</codeph></stentry>
               <stentry>array of <xref href="GroupReference.dita" type="reference">GroupReference</xref></stentry>
               <stentry>No</stentry>
               <stentry><p>Kubernetes group names that own this subscription</p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "groups": [
    {
      "name": "premium-users"
    }
  ]
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Used by</title>
         <link href="MaaSSubscription.dita" type="reference"/>
         <link href="CreateSubscriptionRequest.dita" type="reference"/>
         <link href="UpdateSubscriptionRequest.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
