<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="SubscriptionDetail" xml:lang="en-US">
   <title>SubscriptionDetail</title>
   <refbody>
      <section id="description">
         <p>Model names within a subscription, used to enrich API key search responses</p>
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>displayName</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Human-readable display name of the subscription (falls back to k8s name)</p><p>Example: <codeph>Premium Team</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>models</codeph></stentry>
               <stentry>array of string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Names of models in the subscription (uses display name when available, falls back to k8s name)</p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "displayName": "Premium Team",
  "models": ["granite-3-8b-instruct", "flan-t5-small"]
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Used by</title>
         <link href="ApiKeyListResponse.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
