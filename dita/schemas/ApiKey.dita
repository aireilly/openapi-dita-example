<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="ApiKey" xml:lang="en-US">
   <title>ApiKey</title>
   <refbody>
      <section id="description">
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>id</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Unique identifier for the API key</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>name</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>User-friendly name for the API key</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>description</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Optional description providing context about the key's purpose</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>username</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Username that owns this API key</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>groups</codeph></stentry>
               <stentry>array of string</stentry>
               <stentry>No</stentry>
               <stentry><p>User's groups at creation time (immutable snapshot for authorization)</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>creationDate</codeph></stentry>
               <stentry>string (date-time)</stentry>
               <stentry>Yes</stentry>
               <stentry><p>When the API key was created</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>expirationDate</codeph></stentry>
               <stentry>string (date-time)</stentry>
               <stentry>No</stentry>
               <stentry><p>When the API key expires (empty for permanent keys)</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>status</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Current status of the API key</p><p>Allowed values: <codeph>active</codeph>, <codeph>revoked</codeph>, <codeph>expired</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>lastUsedAt</codeph></stentry>
               <stentry>string (date-time)</stentry>
               <stentry>No</stentry>
               <stentry><p>When the API key was last used for validation</p></stentry>
            </strow>
            <strow>
               <stentry><codeph>subscription</codeph></stentry>
               <stentry>string</stentry>
               <stentry>No</stentry>
               <stentry><p>Name of the subscription associated with this API key</p><p>Example: <codeph>premium-team-sub</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "id": "string",
  "name": "string",
  "description": "string",
  "username": "string",
  "groups": ["string"],
  "creationDate": "2024-01-31T09:30:00Z",
  "expirationDate": "2024-01-31T09:30:00Z",
  "status": "active",
  "lastUsedAt": "2024-01-31T09:30:00Z",
  "subscription": "premium-team-sub"
}</codeblock>
      </example>
   </refbody>
