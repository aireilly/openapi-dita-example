<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference
  PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="TokenRateLimit" xml:lang="en-US">
   <title>TokenRateLimit</title>
   <refbody>
      <section id="description">
         <p>Token-based rate limit for a model</p>
         <p>Type: object</p>
      </section>
      <section id="properties">
         <title>Properties</title>
         <simpletable relcolwidth="2* 2* 1* 5*">
            <sthead>
               <stentry>Property</stentry>
               <stentry>Type</stentry>
               <stentry>Required</stentry>
               <stentry>Description</stentry>
            </sthead>
            <strow>
               <stentry><codeph>limit</codeph></stentry>
               <stentry>integer (int64)</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Maximum number of tokens allowed</p><p>Example: <codeph>100000</codeph></p></stentry>
            </strow>
            <strow>
               <stentry><codeph>window</codeph></stentry>
               <stentry>string</stentry>
               <stentry>Yes</stentry>
               <stentry><p>Time window (e.g., "1m", "1h", "24h")</p><p>Constraints: pattern <codeph>^(\d+)(s|m|h|d)$</codeph></p><p>Example: <codeph>24h</codeph></p></stentry>
            </strow>
         </simpletable>
      </section>
      <example id="example">
         <title>Example</title>
         <codeblock outputclass="language-json">{
  "limit": 100000,
  "window": "24h"
}</codeblock>
      </example>
   </refbody>
   <related-links>
      <linklist>
         <title>Used by</title>
         <link href="ModelSubscriptionRef.dita" type="reference"/>
      </linklist>
   </related-links>
</reference>
